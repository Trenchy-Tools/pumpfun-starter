# The TrenchyTools API. Get a key with one call (no account):  curl "https://api.trenchytools.lol/api/create-api-key?label=pumpfun-starter"
TRENCHY_API_URL=https://api.trenchytools.lol
TRENCHY_API_KEY=

# Where your wallet files live. Leave empty for ~/Desktop/trenchytools-wallets (or ~/trenchytools-wallets without a Desktop).
WALLET_BACKUP_DIR=

# Jito tip paid inside the create transaction of a launch bundle (lamports; 5000000 = 0.005 SOL)
JITO_TIP_LAMPORTS=5000000

PORT=3000
